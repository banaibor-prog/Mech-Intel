# Copy this file to .env and fill in your Firebase project values.
# Get these from Firebase Console > Project Settings > General > Your apps > SDK setup and configuration.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Native Android Google Sign-In requires an Android OAuth client matching the app
# package and debug SHA-1, plus a Web OAuth client ID for the Firebase ID token.
# Use the Web client ID here. The Android client ID is registered in Google Cloud.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
