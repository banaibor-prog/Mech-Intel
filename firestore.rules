rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Signed in and not suspended by an admin. Suspended users can still read and
    // edit their own profile, but cannot post, book, apply, review or report.
    function isActive() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true
      );
    }

    // Admin switch in config/app: when allowNewPosts is false only admins may post jobs.
    function postingOpen() {
      return !exists(/databases/$(database)/documents/config/app) ||
        get(/databases/$(database)/documents/config/app).data.get('allowNewPosts', true) != false ||
        isAdmin();
    }

    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Fields only an admin may write; a user can never grant themselves admin or lift a suspension.
    function adminUserFields() {
      return ['isAdmin', 'suspended', 'suspendedReason', 'suspendedAt', 'suspendedBy'];
    }

    function adminPostFields() {
      return ['hidden', 'hiddenReason', 'hiddenAt', 'hiddenBy'];
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid &&
        !request.resource.data.keys().hasAny(adminUserFields());
      allow update: if request.auth != null && (
        (request.auth.uid == uid && !changes().hasAny(adminUserFields())) ||
        (isAdmin() && changes().hasOnly(adminUserFields()))
      );
      allow delete: if false;
    }

    match /providers/{uid} {
      allow read: if request.auth != null;
      // Verification badges are granted by admins only.
      allow create: if request.auth != null && request.auth.uid == uid &&
        (!('verifications' in request.resource.data) || request.resource.data.verifications.size() == 0);
      allow update: if request.auth != null && (
        (request.auth.uid == uid && !changes().hasAny(['verifications'])) ||
        (isAdmin() && changes().hasOnly(['verifications']))
      );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.providerUid || request.auth.uid == resource.data.customerUid || isAdmin());

      allow create: if isActive() &&
        request.auth.uid == request.resource.data.customerUid &&
        request.resource.data.status == 'pending';

      allow update: if request.auth != null && (
        (
          (request.auth.uid == resource.data.providerUid || request.auth.uid == resource.data.customerUid) &&
          request.resource.data.providerUid == resource.data.providerUid &&
          request.resource.data.customerUid == resource.data.customerUid
        ) ||
        (isAdmin() && changes().hasOnly(['status', 'updatedAt']) && request.resource.data.status == 'cancelled')
      );

      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;

      allow create: if isActive() && postingOpen() &&
        request.auth.uid == request.resource.data.authorUid &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.applicantCount == 0 &&
        !request.resource.data.keys().hasAny(adminPostFields());

      // The author may edit their own post except the admin-only hidden fields.
      // Admins may hide or restore any post. Anyone else may only adjust
      // likeCount/applicantCount by exactly 1 (via toggleLike/applyToPost),
      // leaving every other field — including the author — untouched.
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.authorUid && !changes().hasAny(adminPostFields())) ||
        (isAdmin() && changes().hasOnly(adminPostFields())) ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likeCount', 'applicantCount']) &&
          request.resource.data.authorUid == resource.data.authorUid &&
          request.resource.data.title == resource.data.title &&
          request.resource.data.description == resource.data.description
        )
      );

      allow delete: if request.auth != null && (request.auth.uid == resource.data.authorUid || isAdmin());

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    match /applications/{applicationId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.applicantUid || request.auth.uid == resource.data.postAuthorUid || isAdmin());

      allow create: if isActive() &&
        request.auth.uid == request.resource.data.applicantUid &&
        request.resource.data.status == 'pending';

      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.applicantUid || request.auth.uid == resource.data.postAuthorUid) &&
        request.resource.data.applicantUid == resource.data.applicantUid &&
        request.resource.data.postAuthorUid == resource.data.postAuthorUid &&
        request.resource.data.postId == resource.data.postId;

      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if isActive() &&
        request.auth.uid == request.resource.data.reviewerUid &&
        request.resource.data.targetUid != request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update: if false;
      // Admins may remove abusive or fake reviews; the trust function recomputes on delete.
      allow delete: if isAdmin();
    }

    match /profileReferences/{referenceId} {
      allow read: if request.auth != null;
      allow create: if isActive() &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.targetUid != request.auth.uid;
      allow update, delete: if false;
    }

    // Raw reports/blocks are sensitive: only the reporter, the target, or an
    // admin doing moderation may read them. Trust-score aggregates derived
    // from this collection are public via trustSummaries below instead —
    // that Cloud Function reads this collection with admin privileges, which
    // bypasses these rules, so locking read down here does not affect
    // scoring for anyone.
    match /trustActions/{actionId} {
      allow get: if request.auth != null &&
        (request.auth.uid == resource.data.reporterUid ||
         request.auth.uid == resource.data.targetUid ||
         isAdmin());
      allow list: if request.auth != null && isAdmin();
      allow create: if isActive() &&
        request.auth.uid == request.resource.data.reporterUid &&
        request.resource.data.targetUid != request.auth.uid &&
        request.resource.data.type in ['report', 'block'] &&
        !request.resource.data.keys().hasAny(['status', 'resolution', 'resolvedBy', 'resolvedAt']);
      // Admins resolve or dismiss reports; the report itself is never rewritten.
      allow update: if isAdmin() && changes().hasOnly(['status', 'resolution', 'resolvedBy', 'resolvedAt']);
      allow delete: if false;
    }

    // Server-maintained aggregate trust score per user, kept in sync by the
    // reviews/profileReferences/trustActions Cloud Function triggers
    // (functions/src/trust.ts). Contains no raw report content, so it is
    // safe to expose publicly like reviews/profileReferences above.
    match /trustSummaries/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // App-wide settings (maintenance mode, announcement, feature switches).
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Append-only audit trail of admin actions.
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
