rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /providers/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.providerUid || request.auth.uid == resource.data.customerUid);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.customerUid &&
        request.resource.data.status == 'pending';

      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.providerUid || request.auth.uid == resource.data.customerUid) &&
        request.resource.data.providerUid == resource.data.providerUid &&
        request.resource.data.customerUid == resource.data.customerUid;

      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.authorUid &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.applicantCount == 0;

      // The author may edit any field of their own post. Anyone else may only
      // adjust likeCount/applicantCount by exactly 1 (via toggleLike/applyToPost),
      // leaving every other field — including the author — untouched.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorUid ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likeCount', 'applicantCount']) &&
          request.resource.data.authorUid == resource.data.authorUid &&
          request.resource.data.title == resource.data.title &&
          request.resource.data.description == resource.data.description
        )
      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    match /applications/{applicationId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.applicantUid || request.auth.uid == resource.data.postAuthorUid);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.applicantUid &&
        request.resource.data.status == 'pending';

      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.applicantUid || request.auth.uid == resource.data.postAuthorUid) &&
        request.resource.data.applicantUid == resource.data.applicantUid &&
        request.resource.data.postAuthorUid == resource.data.postAuthorUid &&
        request.resource.data.postId == resource.data.postId;

      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.reviewerUid &&
        request.resource.data.targetUid != request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    match /profileReferences/{referenceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.targetUid != request.auth.uid;
      allow update, delete: if false;
    }

    // Raw reports/blocks are sensitive: only the reporter, the target, or an
    // admin doing moderation may read them. Trust-score aggregates derived
    // from this collection are public via trustSummaries below instead —
    // that Cloud Function reads this collection with admin privileges, which
    // bypasses these rules, so locking read down here does not affect
    // scoring for anyone.
    match /trustActions/{actionId} {
      allow get: if request.auth != null &&
        (request.auth.uid == resource.data.reporterUid ||
         request.auth.uid == resource.data.targetUid ||
         isAdmin());
      allow list: if request.auth != null && isAdmin();
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.reporterUid &&
        request.resource.data.targetUid != request.auth.uid &&
        request.resource.data.type in ['report', 'block'];
      allow update, delete: if false;
    }

    // Server-maintained aggregate trust score per user, kept in sync by the
    // reviews/profileReferences/trustActions Cloud Function triggers
    // (functions/src/trust.ts). Contains no raw report content, so it is
    // safe to expose publicly like reviews/profileReferences above.
    match /trustSummaries/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
